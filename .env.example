# ── AI Provider ───────────────────────────────────────────────────────────
# Supported providers: openai | anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4
# Your OpenAI or Anthropic API key (required)
AI_API_KEY=

# ── AEM Project (auto-populated by the Setup Wizard) ──────────────────────
AEM_PROJECT_PATH=/workspace/aem-projects/basetraining
AEM_GROUP_ID=com.basetraining
AEM_ARTIFACT_ID=basetraining
AEM_APPS_FOLDER=basetraining
AEM_CONTENT_ROOT=basetraining

# ── AEM Instance ──────────────────────────────────────────────────────────
AEM_AUTHOR_URL=http://localhost:4502
AEM_USERNAME=admin
AEM_PASSWORD=admin

# ── Internal paths (pre-configured for Docker — do not change) ────────────
ENV_FILE=/workspace/.env
DB_PATH=/workspace/data.db
PROMPT_PATH=/app/prompts/aem-architect.md
